<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/registration_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_first_name" />

        <EditText
            android:id="@+id/firstNameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoHandwritingEnabled="false"
            android:gravity="start|center_vertical"
            android:hint="@string/hint_first_name"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:textDirection="rtl"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/firstNameError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_first_name"
            android:textColor="@color/error"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_last_name" />

        <EditText
            android:id="@+id/lastNameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoHandwritingEnabled="false"
            android:gravity="start|center_vertical"
            android:hint="@string/hint_last_name"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:textDirection="rtl"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/lastNameError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_last_name"
            android:textColor="@color/error"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_email" />

        <EditText
            android:id="@+id/emailEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoHandwritingEnabled="false"
            android:gravity="start|center_vertical"
            android:hint="@string/hint_email"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:textDirection="rtl"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/emailError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error"
            android:visibility="gone"
            tools:text="@string/error_email_invalid" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_grade" />

        <RadioGroup
            android:id="@+id/gradeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/grade10RadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/grade_10" />

            <RadioButton
                android:id="@+id/grade11RadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:minHeight="48dp"
                android:text="@string/grade_11" />

            <RadioButton
                android:id="@+id/grade12RadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:minHeight="48dp"
                android:text="@string/grade_12" />
        </RadioGroup>

        <TextView
            android:id="@+id/gradeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_grade"
            android:textColor="@color/error"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_major" />

        <Spinner
            android:id="@+id/majorSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:prompt="@string/major_prompt" />

        <TextView
            android:id="@+id/majorError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_major"
            android:textColor="@color/error"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/notificationsCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/checkbox_notifications" />

        <CheckBox
            android:id="@+id/termsCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/checkbox_terms" />

        <TextView
            android:id="@+id/termsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_terms"
            android:textColor="@color/error"
            android:visibility="gone" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/button_login" />

        <TextView
            android:id="@+id/resultTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:text="@string/result_student"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>
